# ---------------------------------------------------------------------------
# Backend environment variables (placeholders only — never commit a real .env)
# ---------------------------------------------------------------------------

# --- Server ---
PORT=5000
NODE_ENV=development

# --- CORS ---
# Comma-separated allowlist of frontend origins permitted to send credentials.
# Wildcards are never used because the session cookie requires an exact origin.
# Local dev default: http://localhost:8080
# Production (Render): https://anupportfolio2025.vercel.app
CLIENT_ORIGIN=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080

# --- Database (MongoDB Atlas) ---
# Only the backend ever sees this value. Never expose it to the frontend.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# --- Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=pf_session
BCRYPT_ROUNDS=12

# --- CV access ---
# "file"     -> stream backend/private/<CV_FILE_NAME> through GET /api/cv
# "proxy"    -> stream CV_EXTERNAL_URL through this server; the browser never
#               sees the upstream URL, and auth is enforced on every byte
# "redirect" -> authenticated 302 to CV_EXTERNAL_URL (browser sees the URL)
CV_SOURCE=proxy
CV_FILE_NAME=Anup-Kundu-CV.pdf
CV_DOWNLOAD_NAME=Anup-Kundu-CV.pdf
# Required when CV_SOURCE is "proxy" or "redirect". Must be an https URL.
# Use a Google Drive *file share* link, e.g.
#   https://drive.google.com/file/d/FILE_ID/view?usp=sharing
# Drive sharing must be "Anyone with the link" so the server can read the file.
CV_EXTERNAL_URL=

# Lifetime of the short-lived token used to open the PDF in a new tab.
# Kept short so a copied URL stops working quickly, but long enough that the
# "Open CV" / "Download CV" buttons still work while the success panel is open.
CV_TICKET_TTL_SECONDS=300
