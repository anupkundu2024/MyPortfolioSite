# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Node dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Production builds & coverage
dist/
frontend/dist/
dist-ssr/
build/
frontend/build/
coverage/

# Environment files
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Protected CV assets
# backend/private/ is served ONLY through the authenticated GET /api/cv endpoint.
# Committing the real CV here would publish it via raw.githubusercontent.com on a
# public repository, bypassing that authentication entirely. The directory itself
# is tracked (via its README) so the path exists after a fresh clone.
backend/private/*
!backend/private/README.md

# Local / Temporary files
*.local
.cache/

# Editor and OS directories
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
