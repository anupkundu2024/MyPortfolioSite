# ---------------------------------------------------------------------------
# Frontend environment variables
#
# WARNING: every VITE_* value is compiled into the public JavaScript bundle and
# is visible to anyone. Never put secrets here — no database URIs, no JWT
# secrets, no API keys that are not meant to be public.
# ---------------------------------------------------------------------------

VITE_APP_TITLE="Anup Kundu | Full Stack Developer"

# Base URL of the Express backend, including the /api prefix.
# Local development:
VITE_API_BASE_URL="http://localhost:5000/api"
# Production (set this in the Vercel project's Environment Variables to the
# real Render service URL, e.g. https://<your-service>.onrender.com/api):
# VITE_API_BASE_URL="https://<your-render-service>.onrender.com/api"
